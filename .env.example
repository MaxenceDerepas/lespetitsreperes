# =====================================================================
#  Les Petits Repères — variables d'environnement
#  Copie ce fichier en `.env.local` puis renseigne les valeurs.
#  Aucune de ces valeurs ne doit être committée dans le dépôt.
# =====================================================================

# --- Site ------------------------------------------------------------
# URL publique du site (sans slash final). Utilisée pour les liens des
# emails, le sitemap et les redirections Stripe.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Paiement : Stripe -----------------------------------------------
# Tant que ces variables sont vides, le site fonctionne en MODE DÉMO :
# le tunnel d'achat va jusqu'au bout sans débit réel.
# Clés de test disponibles sur https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Secret du endpoint webhook (`stripe listen --forward-to localhost:3000/api/stripe/webhook`)
STRIPE_WEBHOOK_SECRET=

# --- Base de données -------------------------------------------------
# Optionnel. Sans DATABASE_URL, les commandes sont stockées dans un
# fichier JSON local (./.data/orders.json) — parfait pour le développement,
# à remplacer par Postgres/Supabase en production.
DATABASE_URL=

# --- Stockage privé des PDF ------------------------------------------
# Optionnel. Sans ces valeurs, les PDF sont lus depuis ./private/files
# (dossier hors `public/`, donc jamais servi en direct).
# Exemple Supabase Storage (bucket PRIVÉ obligatoire) :
STORAGE_URL=
STORAGE_BUCKET=produits-pdf
SUPABASE_SERVICE_ROLE_KEY=

# --- Email transactionnel --------------------------------------------
# Optionnel. Sans clé, les emails sont écrits dans la console du serveur.
# Resend : https://resend.com/api-keys
EMAIL_API_KEY=
EMAIL_FROM="Les Petits Repères <petitsreperes@gmail.com>"
EMAIL_REPLY_TO=petitsreperes@gmail.com

# --- Sécurité des liens de téléchargement ----------------------------
# Secret utilisé pour signer les liens de téléchargement (HMAC-SHA256).
# Génère une valeur avec : openssl rand -hex 32
DOWNLOAD_TOKEN_SECRET=change-moi-en-production
# Durée de validité d'un lien, en heures.
DOWNLOAD_LINK_TTL_HOURS=72
# Nombre maximum de téléchargements par fichier acheté (0 = illimité).
DOWNLOAD_MAX_COUNT=10

# --- Espace d'administration -----------------------------------------
# Mot de passe simple pour /admin (à remplacer par une vraie auth en prod).
ADMIN_PASSWORD=
